<?xml version="1.0" encoding="utf-8"?>
<!--
  Content is vertically centred so the widget still looks deliberate when the user stretches it,
  rather than stranding three lines of text at the top of a large empty box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="Day 1" />

        <TextView
            android:id="@+id/widget_phase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Period" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_timing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Period in 16 days" />

    <TextView
        android:id="@+id/widget_mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="Tap to set up" />

    <TextView
        android:id="@+id/widget_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
